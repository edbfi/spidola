{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "extends": [
    "github>edbfi/automation//default.json#v3.0.1",
    "github>edbfi/automation//mixed.json#v3.0.1"
  ],
  "packageRules": [
    {
      "description": "MPVKit must retain the licensed LGPL build and verified notices.",
      "matchPackageNames": [
        "/mpv/i"
      ],
      "groupName": "LGPL media dependencies"
    },
    {
      "description": "Gradle extraction mistakes the three ABI filter names for a Maven coordinate; these are Android architecture identifiers.",
      "matchManagers": [
        "gradle"
      ],
      "matchDatasources": [
        "maven"
      ],
      "matchFileNames": [
        "apps/androidtv/app/build.gradle.kts"
      ],
      "matchPackageNames": [
        "arm64-v8a:armeabi-v7a"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/ci/apple-tools\\.env$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+)\\s+[A-Z_]+=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(android|release)\\.yml$/"
      ],
      "matchStrings": [
        "cargo install (?<depName>cargo-ndk) --locked --version (?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/android\\.yml$/"
      ],
      "matchStrings": [
        "KOTLIN_VERSION: [\"']?(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "JetBrains/kotlin",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/ci/build-contract-harness-android\\.sh$/"
      ],
      "matchStrings": [
        "coroutines_version=\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/ci/build-contract-harness-android\\.sh$/"
      ],
      "matchStrings": [
        "jna_version=\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "net.java.dev.jna:jna",
      "datasourceTemplate": "maven"
    }
  ],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "automergeStrategy": "rebase",
  "automergeType": "pr"
}
